# Metrics dashboard — set before deploying
METRICS_PASSWORD=change-me-to-a-long-random-password

# Optional: custom hidden URL (default: /internal/site-insights-k9m2)
# METRICS_PATH=/your-secret-path-here

# Optional: secret phrase typed on the public site to open metrics (default: insights)
# METRICS_GATE_KEY=insights

# Optional: separate signing secret for session cookies (defaults to METRICS_PASSWORD)
# METRICS_SECRET=another-long-random-string

# Vercel Blob — private store for persistent analytics and blog engagement in production.
# Create a private Blob store (e.g. region lhr1) and connect it to this project.
# BLOB_READ_WRITE_TOKEN=

# Legacy alias — still supported if METRICS_PASSWORD is unset
# ADMIN_PASSWORD=change-me-to-a-long-random-password
